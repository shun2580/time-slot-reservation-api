# 見本。`cp .env.example .env` で .env を作り、change-me- の値を書き換える。
# .env は追跡外(.gitignore)。ここにはダミー値だけを書き、実際の秘密は決して commit しない。

# --- API(internal/config が読む鍵。欠けると起動失敗する) ---
APP_HTTP_ADDR=:8080
# DB の host/port は compose の内部名。API をホストで直接動かすなら 127.0.0.1 と 3307 に直す。
APP_DB_HOST=mysql
APP_DB_PORT=3306
APP_DB_USER=slotres
# migrate の接続 URL に入るため、記号(@ : / ? # %)を含めぬこと。
APP_DB_PASSWORD=change-me-db-password
APP_DB_NAME=slotres

# iss は利用者がトークンを得る外部名に固定する(compose の KC_HOSTNAME と同じ origin にそろえる)。
APP_KEYCLOAK_ISSUER=http://localhost:8081/realms/slotres
# JWKS は API から見える内部名(keycloak:8080)で取る。issuer と host が違うのは意図どおり。
APP_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/slotres/protocol/openid-connect/certs
APP_JWT_AUDIENCE=slot-api

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# --- Keycloak ---
# 管理コンソール(http://localhost:8081)の初期管理者。
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin-password
# realm JSON(docker/keycloak/slotres-realm.json)の ${...} に取り込み時に入る開発用利用者のパスワード。
SLOTRES_USER1_PASSWORD=change-me-user1-password
SLOTRES_USER2_PASSWORD=change-me-user2-password
SLOTRES_ADMIN1_PASSWORD=change-me-admin1-password
